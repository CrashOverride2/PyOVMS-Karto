# -----------------------------------------------------------------------------
# Karto Microservice Environment Configuration Template
#
# Copy this file to 'karto.env' or '.env' and fill in the values.
# The application will load the first file it finds.
# -----------------------------------------------------------------------------

# --- Logging ---
# The logging level for the application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Service Security ---
# Public half of the OVMS main server's session signing key (base64, 32 bytes). The main
# server prints it when it generates the pair; you can also read it back with:
#     python -m app.jwt_keys      (run in the OVMS server directory)
#
# Only the PUBLIC key belongs here. Karto verifies session cookies and must never be
# able to issue one: with the old shared symmetric SECRET_KEY_JWT, anyone who could read
# this file could mint a token for any OVMS user, administrators included.
# The service refuses to start without a usable key.
JWT_PUBLIC_KEY=

# SECRET_KEY_JWT and ALGORITHM are obsolete. If your existing karto.env still sets them,
# delete those lines — a leftover copy of the main server's signing secret on this host
# is exactly what the switch to asymmetric keys was meant to eliminate.

# --- MQTT Broker ---
# Connection details for the MQTT broker that provides vehicle data.
# This should be the same broker your OVMS server and vehicles connect to.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# This user must have read permissions on the 'ovms/+/+/metric/#' topic tree.
MQTT_USER=karto_service_user
MQTT_PASSWORD=a_very_strong_mqtt_password_for_karto

# --- Databases ---
# Connection string for the Karto service's own PostgreSQL database with the PostGIS extension.
# This is where trip and GPS data will be stored.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://karto_user:karto_password@localhost:5432/karto

# Read-only connection string for the main OVMS Server's database.
# Karto needs this to verify vehicle ownership and check if trip tracking is enabled.
# This user should ideally have read-only permissions on the OVMS database.
# Example for PostgreSQL:
# OVMS_DATABASE_URL=postgresql+psycopg2://ovms_readonly_user:readonly_password@localhost:5432/ovms
# Example for MySQL:
# OVMS_DATABASE_URL=mysql+pymysql://ovms_readonly_user:readonly_password@localhost:3306/ovms
OVMS_DATABASE_URL=postgresql+psycopg2://ovms_readonly_user:readonly_password@localhost:5432/ovms

# --- File Storage ---
# The local directory where generated map preview images will be stored.
# This path is relative to the project root. Defaults to './data/maps'.
#MAPS_STORAGE_PATH=./data/maps

# --- Map Generation (strongly recommended) ---
# Path to a local PMTiles basemap. Without it, map rendering falls back to staticmap3,
# which downloads tiles from tile.openstreetmap.org — one request per trip, for exactly
# that trip's bounding box, at high zoom. That hands a derivable movement profile of all
# your users to a third party and breaches the OSM tile usage policy. The service logs a
# warning at startup when this is unset.
#KARTO_PMTILES_PATH=./data/maps/your_map_file.pmtiles

# Alternative to PMTiles: your own XYZ tile server for the staticmap3 fallback.
#KARTO_TILE_URL_TEMPLATE=https://tiles.example.internal/{z}/{x}/{y}.png

# Last resort. Setting this to true renders via tile.openstreetmap.org, which means each
# trip's bounding box leaves your server. Without it (and without the two settings
# above) map previews are simply skipped; trip tracking is unaffected.
#KARTO_ALLOW_EXTERNAL_TILES=false

# --- Network ---
# Address the API binds to. Defaults to 127.0.0.1: Karto is meant to sit behind the
# reverse proxy that also fronts the OVMS server. Binding 0.0.0.0 exposes the trip API
# directly, bypassing TLS and the main server's IP blocking. Only change this if the
# proxy runs on another host or in a separate container network.
#SERVER_HOST=127.0.0.1
#HTTP_PORT=8001

# Peers whose X-Forwarded-For header is trusted — list your reverse proxy here.
# Must never be "*" or a zero-length prefix such as 0.0.0.0/0: uvicorn then takes the
# leftmost, client-controlled entry, letting any caller choose its own identity for the
# rate limiter (and drive a victim's address into a ban). The service refuses to start
# in that configuration.
#FORWARDED_ALLOW_IPS=127.0.0.1

# Publish the OpenAPI docs at /docs, /redoc and /openapi.json. Off by default: there is
# no way to authenticate them here, and they enumerate the full API surface.
#ENABLE_API_DOCS=false

# --- Authentication rate limiting ---
# Failed API-key authentications per IP within API_FAIL_WINDOW_SECONDS before that
# address is banned for API_BAN_MINUTES.
#API_FAIL_LIMIT=10
#API_FAIL_WINDOW_SECONDS=60
#API_BAN_MINUTES=60

# --- Trip Logic Thresholds (Optional Overrides) ---
# You can override the default trip logic by uncommenting and setting these variables.

# Time in seconds to wait after an 'engine off' signal before ending a trip. Default: 120
#KARTO_TRIP_END_GRACE_PERIOD_SECONDS=120

# Time in seconds of inactivity (no new GPS points) before a trip is considered timed-out. Default: 1800
#KARTO_TRIP_TIMEOUT_SECONDS=1800

# Minimum total distance (in km) for a trip to be considered valid and saved. Default: 1.0
#KARTO_TRIP_MIN_DISTANCE_KM=1.0

# --- GPS Filtering Thresholds (Optional Overrides) ---
# A new GPS point will only be saved if the speed is above this value (in KPH). Default: 5.0
#KARTO_GPS_MIN_SPEED_KPH=5.0

# Or if the distance from the last saved point is greater than this value (in meters). Default: 20.0
#KARTO_GPS_MIN_DISTANCE_METERS=20.0

# Minimum time interval (in seconds) between GPS updates to prevent spam. Default: 1.0
#KARTO_GPS_UPDATE_MIN_INTERVAL_SECONDS=1.0

# --- Buffered GPS log records (notify/data/...) ---
# A pause longer than this (in seconds) between two records means the vehicle was off; the
# next record is then kept regardless of the speed/distance filter. Default: 120.0
#KARTO_GPSLOG_FILTER_RESET_SECONDS=120.0

# A XSQ-GPS-Log record reporting motion with a position older than this (in seconds) repeats
# a frozen position, e.g. after losing the GPS in a tunnel, and is dropped. Default: 10.0
#KARTO_GPSLOG_MAX_FIX_AGE_SECONDS=10.0
